# Data (large, regenerable from raw source or the pipeline itself)
data/raw/*
data/raw/**/*
!data/raw/.gitkeep
!data/raw/*/
!data/raw/*/.gitkeep
data/processed/*
data/processed/**/*
!data/processed/.gitkeep
!data/processed/*/
!data/processed/*/.gitkeep

# Research outputs, checkpoints, caches (large, regenerable)
outputs/**
!outputs/
!outputs/stew/
!outputs/**/.gitkeep
*.pt
*.pth
*.ckpt

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
build/
dist/
.cache/

# Virtual environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS-specific junk
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/

# Environment secrets (if you ever add API keys, wandb, etc.)
.env
